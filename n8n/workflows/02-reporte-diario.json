            "index": 0
          }
        ]
      ]
    },
    "Armar reporte": {
      "main": [
        [
          {
            "node": "Enviar reporte",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
