<!--
  Respuesta activa del proyecto, lista para AGREGAR al final de
  /var/ossec/etc/ossec.conf del manager (Wazuh admite varios <ossec_config>).
  Ver docs/05-respuesta-activa.md, paso 2.
-->
<ossec_config>

<!-- ===================== Comandos de respuesta activa ===================== -->
<!-- En Wazuh 4.14 el ossec.conf por defecto define firewall-drop, host-deny,
     route-null y disable-account. Hay que AGREGAR netsh y firewalld-drop
     (los binarios ya vienen en los agentes) y remove-threat (script propio, UC-03).
     Si alguno ya existe en tu ossec.conf, no lo dupliques. -->
<command>
  <name>netsh</name>
  <executable>netsh.exe</executable>
  <timeout_allowed>yes</timeout_allowed>
</command>

<command>
  <name>firewalld-drop</name>
  <executable>firewalld-drop</executable>
  <timeout_allowed>yes</timeout_allowed>
</command>

<command>
  <name>remove-threat</name>
  <executable>remove-threat.sh</executable>
  <timeout_allowed>no</timeout_allowed>
</command>

<!-- ===================== Respuestas activas ===================== -->

<!-- UC-01: fuerza bruta SSH. Ambas respuestas se ejecutan en el equipo atacado
     (location local). En Ubuntu/Debian actúa firewall-drop (iptables); en Red Hat
     actúa firewalld-drop. El script que no aplica a la distro solo registra un
     error inofensivo en /var/ossec/logs/active-responses.log del agente.
     (No uses defined-agent aquí: ejecutaría el bloqueo en ese agente fijo
     aunque el ataque haya sido contra otro.) -->
<active-response>
  <disabled>no</disabled>
  <command>firewall-drop</command>
  <location>local</location>
  <rules_id>5763,5712</rules_id>
  <timeout>600</timeout>
</active-response>

<active-response>
  <disabled>no</disabled>
  <command>firewalld-drop</command>
  <location>local</location>
  <rules_id>5763,5712</rules_id>
  <timeout>600</timeout>
</active-response>

<!-- UC-02: fuerza bruta RDP en Windows (netsh). En 4.14 los scripts de bloqueo
     toman la IP de data.srcip o, en Windows, de data.win.eventdata.ipAddress -->
<active-response>
  <disabled>no</disabled>
  <command>netsh</command>
  <location>local</location>
  <rules_id>100110,100111</rules_id>
  <timeout>600</timeout>
</active-response>

<!-- UC-03: eliminación de archivo malicioso detectado por VirusTotal -->
<active-response>
  <disabled>no</disabled>
  <command>remove-threat</command>
  <location>local</location>
  <rules_id>87105</rules_id>
</active-response>

</ossec_config>
