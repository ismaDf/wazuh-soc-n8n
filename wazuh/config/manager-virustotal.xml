<!--
  Integración con VirusTotal (UC-03), lista para AGREGAR al final de ossec.conf.
  Reemplaza TU_API_KEY_VIRUSTOTAL (ver docs/05-respuesta-activa.md, paso 3).
-->
<ossec_config>

<!-- ===================== Integración con VirusTotal (UC-03) ===================== -->
<!-- Cuenta gratuita: 4 consultas/min. Solo analiza eventos FIM (grupo syscheck). -->
<integration>
  <name>virustotal</name>
  <api_key>TU_API_KEY_VIRUSTOTAL</api_key>
  <group>syscheck</group>
  <alert_format>json</alert_format>
</integration>

</ossec_config>
